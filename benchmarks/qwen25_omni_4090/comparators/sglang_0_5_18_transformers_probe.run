#!/bin/sh
# Reproduce the frozen SGLang compatibility probe. On SGLang 0.5.18 this
# fails closed before weight loading because the Transformers wrapper cannot
# construct the checkpoint's full Qwen2_5OmniConfig through AutoModel.
set -eu

: "${APXINF_WORKDIR:?set the ApxInf source checkout}"
: "${APXINF_MODEL_DIR:?set the Qwen2.5-Omni model directory}"
: "${APXINF_SGLANG_PYTHON:?set the SGLang Python executable}"
: "${APXINF_CACHE_ROOT:?set a writable cache directory}"

gpu_run=${APXINF_GPU_RUN:-gpu-run}

exec chpst -u gpuq:gpuq-users "$gpu_run" \
  --owner codex-apxinf --label sglang-0518-qwen25-omni-transformers \
  --mode exclusive --gpu-count 1 \
  --cwd "$APXINF_WORKDIR" \
  --estimate 30m --queue-timeout 2h --run-timeout 1h -- \
  env \
  SETUPTOOLS_USE_DISTUTILS=local \
  HF_HOME="$APXINF_CACHE_ROOT/huggingface" \
  TRANSFORMERS_OFFLINE=1 \
  HF_HUB_OFFLINE=1 \
  TOKENIZERS_PARALLELISM=false \
  XDG_CACHE_HOME="$APXINF_CACHE_ROOT" \
  TORCH_HOME="$APXINF_CACHE_ROOT/torch" \
  TORCHINDUCTOR_CACHE_DIR="$APXINF_CACHE_ROOT/torchinductor" \
  TORCH_EXTENSIONS_DIR="$APXINF_CACHE_ROOT/torch-extensions" \
  TRITON_CACHE_DIR="$APXINF_CACHE_ROOT/triton" \
  CUDA_CACHE_PATH="$APXINF_CACHE_ROOT/cuda" \
  FLASHINFER_WORKSPACE_BASE="$APXINF_CACHE_ROOT/flashinfer" \
  "$APXINF_SGLANG_PYTHON" -m sglang.launch_server \
  --model-path "$APXINF_MODEL_DIR" \
  --served-model-name Qwen/Qwen2.5-Omni-3B \
  --host 127.0.0.1 --port 8004 \
  --model-impl transformers --enable-multimodal --trust-remote-code \
  --dtype bfloat16 --context-length 32768 \
  --max-running-requests 1 --max-total-tokens 32768 \
  --chunked-prefill-size 32768 --max-prefill-tokens 32768 \
  --mem-fraction-static 0.8 --disable-radix-cache \
  --disable-cuda-graph --stream-interval 1
